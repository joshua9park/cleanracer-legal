---
// The frame around every page: the head (title, description, share cards, icons), the shared styles, and the body. The page puts its own header and footer
// components where it wants them, and its own styles in the "head" slot.
import "../styles/shell.css";
interface Props { title: string; description?: string; canonical?: string; image?: "cust" | "biz"; bodyClass?: string; themeColor?: string; noindex?: boolean; refresh?: string; jsonLd?: string }
const { title, description, canonical, image = "cust", bodyClass, themeColor = "#FFFFFF", noindex = false, refresh, jsonLd } = Astro.props;
const og = `https://cleanracer.com/assets/og-${image}.png`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{title}</title>
  {description && <meta name="description" content={description}>}
  <meta name="theme-color" content={themeColor}>
  {noindex && <meta name="robots" content="noindex">}
  {canonical && <link rel="canonical" href={canonical}>}
  {refresh && <meta http-equiv="refresh" content={refresh}>}
  {description && canonical && (<>
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={canonical}>
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Clean Racer">
    <meta property="og:image" content={og}>
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="Clean Racer">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={og}>
  </>)}
  <link rel="icon" href="/assets/favicon.png">
  <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
  {jsonLd && <script type="application/ld+json" set:html={jsonLd}></script>}
  <slot name="head" />
</head>
<body class={bodyClass}>
  <slot />
</body>
</html>
