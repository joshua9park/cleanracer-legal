---
// The footer every page shares: who we are, and the same four links.
interface Props { dark?: boolean; narrow?: boolean }
const { dark = false, narrow = false } = Astro.props;
---
<footer class:list={["sx-foot", { dark, narrow }]}>
  <div class="in">
    <address>© 2026 <b>MOTHER PARKERSON LLC</b>, doing business as Clean Racer<br>603 Mininger Road, Souderton, PA 18954, USA</address>
    <span class="links"><a href="/support/">Support</a><a href="/terms/">Terms of Use</a><a href="/privacy/">Privacy Policy</a><a href="mailto:support@cleanracer.com">support@cleanracer.com</a></span>
  </div>
</footer>
