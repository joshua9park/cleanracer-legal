---
// The pricing questions, from src/data/plans.ts.
import { faq } from "../data/plans";
---
<div class="faq">
  {faq.map((f) => <details><summary>{f.q}</summary><p set:html={f.a} /></details>)}
</div>
<style>
.faq{max-width:760px}
.faq details{border-top:.5px solid var(--line);padding:14px 2px}
.faq summary{font-weight:600;cursor:pointer}
.faq p{color:var(--muted);margin-top:8px}
</style>
