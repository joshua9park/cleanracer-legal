---
// The "get the app" row: Google's official "Get it on Google Play" badge (unmodified, linked to the app's listing) and Apple's official "Download on the App Store" badge (unmodified, linked to the app's listing).
// The Google badge image has clear space built in, so it is pulled in with negative margins to line up with Apple's.
interface Props { play: string; ios: string; app: string }
const { play, ios, app } = Astro.props;
---
<div class="sb">
  <a class="sb-play" href={play} target="_blank" rel="noopener" aria-label={`Get ${app} on Google Play`}><img src="/assets/google-play-badge.png" alt="Get it on Google Play" width="186" height="72"></a>
  <a class="sb-ios" href={ios} target="_blank" rel="noopener" aria-label={`Download ${app} on the App Store`}><img src="/assets/app-store-badge.svg" alt="Download on the App Store" width="144" height="48"></a>
</div>
<style>
.sb{display:flex;flex-wrap:wrap;align-items:center;gap:12px;margin:26px 0 0}
.sb-play{display:inline-block;line-height:0}
.sb-play img{display:block;height:72px;width:auto;margin:-12px -12px -12px -12px}
.sb-ios{display:inline-block;line-height:0}
.sb-ios img{display:block;height:48px;width:auto}
/* on a phone the two stay in one row: a smaller badge, and the box says its two lines under each other */
@media(max-width:520px){
  .sb{flex-wrap:nowrap;gap:10px}
  .sb-play img{height:60px;margin:-10px -10px -10px -10px}
  .sb-ios img{height:40px}
}
</style>
