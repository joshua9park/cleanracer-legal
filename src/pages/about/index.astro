---
import Base from "../../layouts/Base.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import "../../styles/marketing.css";

const principles = [
  { title: "Made for independents", text: "Plans start at $19.99 a month. No hardware to buy, and no POS to replace." },
  { title: "Your money stays yours", text: "Customers who pay by card in the app pay your own Stripe account directly. We never hold your money." },
  { title: "Private by design", text: "No ads, no selling data, and no tracking of where anyone is." },
];
---
<Base title="About Us · Clean Racer" description="Clean Racer is developed in the labs at Mother Parkerson, a web and mobile application development company in Souderton, Pennsylvania." canonical="https://cleanracer.com/about/">
<SiteHeader />

<section style="padding:56px 0 40px"><div class="wrap">
  <span class="eyebrow">About us</span>
  <h1>Built by a team who builds for business.</h1>
  <p class="lede" style="max-width:40em">Clean Racer is developed in the labs at <b>Mother Parkerson</b>, a web and mobile application development company in Souderton, Pennsylvania. For more than 15 years, we've solved problems unique to each industry we've worked in, by building software that fits the business, not the other way around. Clean Racer brings that approach to dry cleaning.</p>
</div></section>

<section class="gray"><div class="wrap">
  <div class="sec-head"><span class="tag">Why Clean Racer</span><h2>Pickup and delivery, without the overhaul.</h2><p>Independent dry cleaners already know their customers by name. Offering pickup and delivery shouldn't mean replacing your register or buying new equipment. Clean Racer works on the phones you already have.</p></div>
</div></section>

<section><div class="wrap">
  <div class="sec-head"><span class="tag">How we build it</span><h2>Three things we hold to.</h2></div>
  <div class="about-cards">
    {principles.map((p) => <div><h3>{p.title}</h3><p>{p.text}</p></div>)}
  </div>
</div></section>

<section class="gray"><div class="wrap">
  <div class="sec-head"><span class="tag">Find us</span><h2>The people behind it.</h2></div>
  <div class="about-find">
    <address><b>Clean Racer</b><br>603 Mininger Road<br>Souderton, PA 18954, USA</address>
    <p>Clean Racer is independently owned and run, so when you write to support, you're reaching the people who built it.</p>
    <p>Questions? Write to <a href="mailto:support@cleanracer.com">support@cleanracer.com</a>, or call <a href="tel:+18882970811">(888) 297-0811</a>.</p>
  </div>
</div></section>

<section class="final"><div class="wrap">
  <h2>Ready to run it your way?</h2>
  <p>CR Business is on Google Play now and coming soon to the App Store. Write to us and we'll walk you through applying.</p>
  <div class="cta"><a class="btn primary" href="mailto:application@cleanracer.com?subject=I%27d%20like%20to%20join%20Clean%20Racer">Get in touch</a><a class="btn plain" href="/how-it-works/">See how it works →</a></div>
</div></section>

<SiteFooter />
</Base>

<style is:global>
.about-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
.about-cards>div{background:var(--grouped);border-radius:16px;padding:22px 22px 10px}
.about-cards h3{font-size:19px;line-height:1.25;margin:2px 0 6px}
.about-cards p{color:var(--muted);font-size:16px}
.about-find{max-width:560px;background:#fff;border:1px solid var(--line);border-radius:16px;padding:22px 24px 10px}
.about-find address{font-style:normal;color:var(--muted);margin:0 0 14px}
.about-find address b{color:var(--text)}
.about-find p{color:var(--muted)}
section.final .cta .btn+.btn{margin-left:10px}
@media(max-width:860px){.about-cards{grid-template-columns:1fr}}
</style>
