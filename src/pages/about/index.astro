---
import Base from "../../layouts/Base.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
---
<Base title="About Us · Clean Racer" description="Clean Racer is developed at Mother Parkerson Labs, a web and mobile application development company in Souderton, Pennsylvania." canonical="https://cleanracer.com/about/">
<Fragment slot="head">
<style is:global>
body{background:var(--grouped);color:var(--text);font:17px/1.55 -apple-system,BlinkMacSystemFont,"SF Pro Text","Segoe UI",Roboto,sans-serif;-webkit-font-smoothing:antialiased}
*,*::before,*::after{box-sizing:border-box}
a{color:var(--tint)}
main{max-width:760px;margin:0 auto;padding:44px 20px 70px}
.kicker{color:var(--tint);font-size:14px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;margin-bottom:10px}
h1{font-size:44px;line-height:1.08;letter-spacing:-.03em;font-weight:800;margin:0 0 18px}
.lead{font-size:20px;line-height:1.5;color:var(--muted);margin:0 0 34px}
.lead b{color:var(--text)}
h2{font-size:22px;line-height:1.25;letter-spacing:-.01em;margin:38px 0 14px}
p{margin:0 0 14px;color:var(--muted)}
.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
.card{background:var(--card);border-radius:16px;padding:20px 20px 8px}
.card h3{font-size:17px;line-height:1.3;margin:0 0 8px;color:var(--text)}
.card p{font-size:15.5px}
.find{background:var(--card);border-radius:16px;padding:22px 24px 10px}
.find address{font-style:normal;color:var(--muted);margin:0 0 14px}
.find address b{color:var(--text)}
@media(max-width:700px){h1{font-size:34px}.lead{font-size:18px}.cards{grid-template-columns:1fr}}
</style>
</Fragment>
<SiteHeader narrow />
<main>
  <p class="kicker">About us</p>
  <h1>Built by a developer who builds for local business.</h1>
  <p class="lead">Clean Racer is developed at <b>Mother Parkerson Labs</b>, a web and mobile application development company in Souderton, Pennsylvania. For more than 15 years, we've built software for local businesses across a wide range of industries.</p>

  <h2>Why Clean Racer</h2>
  <p>Independent dry cleaners already know their customers by name. Offering pickup and delivery shouldn't mean replacing your register or buying new equipment. Clean Racer works on the phones you already have.</p>

  <h2>How we build it</h2>
  <div class="cards">
    <div class="card"><h3>Made for independents</h3><p>Every plan is priced for a single store, and every feature is meant to save you a phone call.</p></div>
    <div class="card"><h3>Your money stays yours</h3><p>Customers who pay by card in the app pay your own Stripe account directly. We never hold your money.</p></div>
    <div class="card"><h3>Private by design</h3><p>No ads, no selling data, and no tracking of where anyone is.</p></div>
  </div>

  <h2>Find us</h2>
  <div class="find">
    <address><b>Mother Parkerson Labs</b><br>603 Mininger Road<br>Souderton, PA 18954, USA</address>
    <p>Questions? Write to <a href="mailto:support@cleanracer.com">support@cleanracer.com</a>.</p>
  </div>
</main>
<SiteFooter narrow />
</Base>
