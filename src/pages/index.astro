---
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import StoreButtons from "../components/StoreButtons.astro";
import PlanCards from "../components/PlanCards.astro";
import "../styles/marketing.css";
const ld = "{\"@context\":\"https://schema.org\",\"@type\":\"Organization\",\"name\":\"Clean Racer\",\"legalName\":\"MOTHER PARKERSON LLC\",\"url\":\"https://cleanracer.com/\",\"logo\":\"https://cleanracer.com/assets/cleanracer-icon.png\",\"email\":\"support@cleanracer.com\"}";
---
<Base title="CR Business \u00b7 Pickup and delivery. No hardware, no POS." description="Add pickup and delivery to your dry cleaning business with just your phone: no POS to replace, no hardware to buy. One shared list, intake at the counter, payments recorded. Starter, Growth and Fleet plans." canonical="https://cleanracer.com/" image="biz" jsonLd={ld}>

<SiteHeader to="customers" />
<div class="wrap">
  <header class="hero">
    <div>
      <span class="eyebrow">For dry cleaners · CR Business</span>
      <h1>Pickup and delivery. <em>No hardware, no POS.</em></h1>
      <p class="lede">Add pickup and delivery to your dry cleaning business with just your phone. Your customers book pickups in the Clean Racer app. You confirm, your driver makes the trip, and customers can pay right in the app. The money goes straight to you.</p>
      <StoreButtons play="https://play.google.com/store/apps/details?id=com.cleanracer.business" app="CR Business" />
      <div class="cta">
        <a class="btn primary" href="mailto:application@cleanracer.com?subject=I%27d%20like%20to%20join%20Clean%20Racer">Get in touch</a>
        <a class="btn plain" href="/how-it-works/">See how it works →</a>
      </div>
      <p class="note">Two apps, one account: <b>CR Business</b> for your team, <b>Clean Racer</b> for your customers.</p>
    </div>
    <div class="phone-wrap"><div class="phone real"><div class="screen"><div class="island"></div><img src="/assets/shots/business-home.webp" width="620" height="1347" alt="The CR Business app's Home screen: new pickup requests to confirm, and an overview of the day."></div></div></div>
  </header>
</div>

<section id="features" class="gray"><div class="wrap">
  <div class="sec-head"><span class="tag">CR Business</span><h2>Everything your team needs, nothing it doesn't.</h2><p>Built for the owner, the manager and the driver, on one shared list.</p></div>
<div class="apps">
    <div class="app"><img src="/assets/cleanracer-icon.png" alt="Clean Racer app icon" width="72" height="72"><div><h3>Clean Racer</h3><p>For your customers. They link to you and book pickups.</p><p class="app-get"><a href="https://play.google.com/store/apps/details?id=com.cleanracer.app" target="_blank" rel="noopener">Get it on Google Play →</a></p></div></div>
    <div class="app"><img src="/assets/cleanracer-business-icon.png" alt="CR Business app icon" width="72" height="72"><div><h3>CR Business</h3><p>For your team. Run pickups, intake and deliveries.</p><p class="app-get"><a href="https://play.google.com/store/apps/details?id=com.cleanracer.business" target="_blank" rel="noopener">Get it on Google Play →</a></p></div></div>
  </div>
  <div class="grid">
    <div class="feat"><div class="ico" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M9 11V5a1.5 1.5 0 0 1 3 0v6"/><path d="M12 10.5a1.5 1.5 0 0 1 3 0V12"/><path d="M15 11.5a1.5 1.5 0 0 1 3 0V16a5 5 0 0 1-5 5h-1.5a5 5 0 0 1-4-2L5 15.5a1.5 1.5 0 0 1 2.3-1.9L9 15"/></svg></div><h3>Two taps per stop</h3><p>"On my way" tells the customer you're coming. "Done" completes the stop. That's the whole job.</p></div>
    <div class="feat"><div class="ico" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 4h6v3H9zM9 12h6M9 16h4"/></svg></div><h3>One shared list</h3><p>Everyone sees today's stops. Start one and it's yours. No dispatching needed.</p></div>
    <div class="feat"><div class="ico" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 4v16M7 20h10M5 8h14"/><path d="M5 8l-3 7a3.5 3.5 0 0 0 6 0zM19 8l-3 7a3.5 3.5 0 0 0 6 0z"/></svg></div><h3>Intake and tally</h3><p>Count items and weigh them at the counter. Track every order through "In the Shop" until it's ready.</p></div>
    <div class="feat"><div class="ico" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="6" width="18" height="12" rx="2"/><circle cx="12" cy="12" r="2.5"/><path d="M6.5 12h.01M17.5 12h.01"/></svg></div><h3>Payments, recorded</h3><p>Set the amount due, and record cash or card at delivery. Customers can also pay by card in the app, straight into your own Stripe account. Every payment is recorded.</p></div>
    <div class="feat"><div class="ico" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="9" cy="9" r="3.5"/><path d="M3 20a6 6 0 0 1 12 0"/><path d="M16 5.6a3.5 3.5 0 0 1 0 6.8M18 15a6 6 0 0 1 3 5"/></svg></div><h3>Owners, managers, drivers</h3><p>Everyone gets the access they need. Managers handle disputes, overrides and the unpaid list.</p></div>
    <div class="feat"><div class="ico" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 21s7-6.2 7-11.5a7 7 0 0 0-14 0C5 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg></div><h3>Your service area</h3><p>Set your hours and a service radius. Customers inside it can book.</p></div>
  </div>
</div></section>

<section id="screens"><div class="wrap">
  <div class="sec-head"><span class="tag">In the app</span><h2>From the doorstep to the counter.</h2><p>Every stop on a map, a quick count at intake, a photo at the door to prove it arrived, and cards in the app. Two taps per stop.</p></div>
  <div class="rail-nav" aria-hidden="true"><button type="button" id="rail-prev" aria-label="Previous screens">‹</button><button type="button" id="rail-next" aria-label="Next screens">›</button></div>
  <div class="phones3" id="rail" tabindex="0" role="region" aria-label="CR Business screens, scroll sideways">
    <figure><div class="phone real"><div class="screen"><div class="island"></div><img src="/assets/shots/business-map.webp" width="620" height="1347" alt="The stops map in CR Business: today's selected pickups pinned across the city, with the list below." loading="lazy"></div></div><figcaption><b>Every stop on a map</b><span>Pickups and deliveries, pinned. Select several and roll.</span></figcaption></figure>
    <figure><div class="phone real"><div class="screen"><div class="island"></div><img src="/assets/shots/business-today.webp" width="620" height="1347" alt="Today in CR Business: pickups, orders in the shop and deliveries on one shared list." loading="lazy"></div></div><figcaption><b>One list for the day</b><span>Everyone sees today's stops. Start one and it's yours.</span></figcaption></figure>
    <figure><div class="phone real"><div class="screen"><div class="island"></div><img src="/assets/shots/business-stop.webp" width="620" height="1347" alt="A pickup stop in CR Business: the address, the customer's note, Navigate, Call and Message, and one big On my way button." loading="lazy"></div></div><figcaption><b>Two taps per stop</b><span>On my way. Picked up. That's the whole job.</span></figcaption></figure>
    <figure><div class="phone real"><div class="screen"><div class="island"></div><img src="/assets/shots/business-intake.webp" width="620" height="1347" alt="Intake in CR Business: a store ticket number, item counts and a running total." loading="lazy"></div></div><figcaption><b>Count it in, type the amount</b><span>No price lists to build. Add your own ticket number.</span></figcaption></figure>
    <figure><div class="phone real"><div class="screen"><div class="island"></div><img src="/assets/shots/business-photo.webp" width="620" height="1347" alt="Finishing a delivery in CR Business: the driver's photo of garments hanging on a customer's door, attached before tapping Delivered." loading="lazy"></div></div><figcaption><b>Photo at handoff</b><span>Proof it arrived, right in the app.</span></figcaption></figure>
    <figure><div class="phone real"><div class="screen"><div class="island"></div><img src="/assets/shots/business-cards.webp" width="620" height="1347" alt="Card Payments in CR Business: card payments are on, with the store's Stripe account and convenience fee." loading="lazy"></div></div><figcaption><b>Get paid quicker</b><span>Customers pay in the app, straight into your own Stripe account.</span></figcaption></figure>
  </div>
</div></section>

<section id="plans" class="gray"><div class="wrap">
  <div class="sec-head"><span class="tag">Plans</span><h2>Simple pricing for cleaners.</h2><p>Every plan includes every feature and unlimited customers. They differ only in how many drivers you have and how many stops your drivers make each month.</p></div>
  <PlanCards />
  <p style="margin-top:26px"><a class="btn plain" href="/pricing/">See full pricing, card fees and questions →</a></p>
</div></section>

<section class="final"><div class="wrap">
  <h2>Ready to run it your way?</h2>
  <p>CR Business is on Google Play now and coming soon to the App Store. Write to us and we'll walk you through applying.</p>
  <div class="cta"><a class="btn primary" href="mailto:application@cleanracer.com?subject=I%27d%20like%20to%20join%20Clean%20Racer">Get in touch</a></div>
</div></section>

<SiteFooter />
<script is:inline>
(function(){var r=document.getElementById("rail");if(!r)return;var step=function(){return Math.round(r.clientWidth*0.8)};
document.getElementById("rail-prev").onclick=function(){r.scrollBy({left:-step(),behavior:"smooth"})};
document.getElementById("rail-next").onclick=function(){r.scrollBy({left:step(),behavior:"smooth"})};
r.addEventListener("keydown",function(e){if(e.key==="ArrowRight"){r.scrollBy({left:step(),behavior:"smooth"})}else if(e.key==="ArrowLeft"){r.scrollBy({left:-step(),behavior:"smooth"})}});})();
</script>
</Base>
