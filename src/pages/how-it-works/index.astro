---
import Base from "../../layouts/Base.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import "../../styles/marketing.css";

// Getting started: the four steps from application to a first customer. Every day: one row each, in the order a day runs, with an app screenshot beside it.
const start = [
  { title: "Apply in the app", text: "Download Clean Racer Business and tell us about your store: its name, address and hours, and a photo of your business license." },
  { title: "We check it's you", text: "We verify your license and call the number on your Google listing. It usually takes one to two business days." },
  { title: "Subscribe and open your store", text: "Pick a plan through the App Store or Google Play. Your store opens the moment the purchase is confirmed, and setup takes about 20 minutes." },
  { title: "Invite your customers", text: "Share your QR code or link. Customers join your store in the Clean Racer app and request pickups." },
];
const daily = [
  { title: "Confirm the requests", text: "New pickup requests land on your Home screen with the day and time your customer asked for. Tap Confirm, or Decline. Your customer is told either way. Below them, a quick overview: pickups and deliveries today, what's in the shop, and what you're owed.", img: "business-home", alt: "The Clean Racer Business app's Home screen: new pickup requests to confirm, and an overview of pickups, deliveries, orders in the shop and money owed." },
  { title: "See your whole day", text: "Today lists every pickup and delivery in one place, with the time window beside each. Your whole team sees the same list, so there's nothing to assign. Whoever starts a stop claims it.", img: "business-today", alt: "The Today screen: the day's pickups with their time windows, and orders in the shop." },
  { title: "Know your route", text: "Open the map to see the day's stops, numbered, with each customer's address and window underneath. One tap on On my way lets all of those customers know you're headed out.", img: "business-map", alt: "The route map: five numbered pickups with addresses and time windows, and an On my way button." },
  { title: "Two taps a stop", text: "At each stop you see the address and your customer's note, with Navigate, Call and Message right there. Tap On my way and your customer gets a heads-up, then Picked up, or Delivered. That's the whole job.", img: "business-stop", alt: "A pickup stop in Clean Racer Business: the address, the customer's note, Navigate, Call and Message, and one big On my way button." },
  { title: "Count it in at the counter", text: "When the order reaches your shop, tap Count items. Tag it with your own ticket number if you like, tally shirts, pants and the rest with a plus and a minus, and tap Start cleaning. Your customer can follow along.", img: "business-intake", alt: "The intake screen: an optional ticket number and a tally of garments by type, with a Start cleaning button." },
  { title: "Deliver the order", text: "Deliveries show what's due and any note from your customer, like \"leave with the doorman.\" Navigate, Call and Message are right there. Tap On my way, then Delivered.", img: "business-collect", alt: "A delivery stop: the address, the amount to collect, the customer's note, Navigate, Call and Message, and an On my way button." },
  { title: "Record the payment, add a photo", text: "If there's a balance, the app asks, \"Did you collect payment?\" before it lets you finish, so every payment ends up recorded. Customers who paid in the app are already marked paid. A photo of the order at the door is optional, and one more way to show it arrived.", img: "business-photo", alt: "Finishing a delivery: the question Did you collect payment? with Yes and No, and a photo of the garments at the door." },
  { title: "Get paid your way", text: "Cash, card at the door, or card in the app, straight into your own Stripe account. Connect your Stripe account in the app to take cards, and set the small convenience fee your customers pay for using them, anywhere from $0 to $3. It's yours to keep. Every payment is recorded.", img: "business-cards", alt: "Card Payments in Clean Racer Business: card payments are on, with the store's Stripe account and convenience fee." },
];
const promise = [
  { title: "No hardware, no POS to replace", text: "It runs on the phones you already have." },
  { title: "No location tracking", text: "Customers get a simple heads-up when the driver is on the way. Never a map, never an ETA." },
  { title: "Your money stays yours", text: "Card payments go straight to your own Stripe account. We never hold it." },
];
---
<Base title="How It Works · Clean Racer Business" description="From your application to your first pickup, then two taps a stop. How Clean Racer Business works for dry cleaners." canonical="https://cleanracer.com/how-it-works/" image="biz">
<SiteHeader />

<section style="padding:56px 0 40px"><div class="wrap">
  <span class="eyebrow">How it works</span>
  <h1>From application to your first pickup.</h1>
  <p class="lede">A few days to open your store. Two taps to run every stop.</p>
</div></section>

<section class="gray"><div class="wrap">
  <div class="sec-head"><span class="tag">Getting started</span><h2>Open your store in four steps.</h2></div>
  <ol class="hiw-steps">
    {start.map((s, i) => <li><span class="hiw-n">{i + 1}</span><div><h3>{s.title}</h3><p>{s.text}</p></div></li>)}
  </ol>
</div></section>

<section><div class="wrap">
  <div class="sec-head"><span class="tag">Every day</span><h2>Then it runs on two taps.</h2><p>Here is a day in Clean Racer Business, from the first request to the last payment.</p></div>
  {daily.map((d) => (
    <div class="hiw-row">
      <div class="hiw-text"><h3>{d.title}</h3><p>{d.text}</p></div>
      <div class="phone-wrap"><div class="phone real"><div class="screen"><img src={`/assets/shots/${d.img}.webp`} width="620" height="1347" alt={d.alt} loading="lazy"></div></div></div>
    </div>
  ))}
</div></section>

<section class="gray"><div class="wrap">
  <div class="sec-head"><span class="tag">What you can count on</span><h2>The simple promises.</h2></div>
  <div class="hiw-promise">
    {promise.map((p) => <div><h3>{p.title}</h3><p>{p.text}</p></div>)}
  </div>
</div></section>

<section class="final"><div class="wrap">
  <h2>Ready to run it your way?</h2>
  <p>Clean Racer Business is on Google Play now and coming soon to the App Store. Write to us and we'll walk you through applying.</p>
  <div class="cta"><a class="btn primary" href="mailto:application@cleanracer.com?subject=I%27d%20like%20to%20join%20Clean%20Racer">Get in touch</a><a class="btn plain" href="/pricing/">See pricing →</a></div>
</div></section>

<SiteFooter />
</Base>

<style is:global>
.hiw-steps{list-style:none;display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin:0;padding:0}
.hiw-steps li{display:flex;gap:16px;align-items:flex-start;background:#fff;border:1px solid var(--line);border-radius:16px;padding:22px}
.hiw-n{flex:none;width:34px;height:34px;border-radius:50%;background:var(--tint);color:#fff;font-weight:700;display:flex;align-items:center;justify-content:center}
.hiw-steps h3,.hiw-text h3,.hiw-promise h3{font-size:19px;line-height:1.25;margin:2px 0 6px}
.hiw-steps p,.hiw-text p,.hiw-promise p{color:var(--muted);font-size:16px}
.hiw-row{display:grid;grid-template-columns:1fr 320px;gap:56px;align-items:center;padding:26px 0}
.hiw-row+.hiw-row{border-top:.5px solid var(--line)}
.hiw-row:nth-of-type(even){grid-template-columns:320px 1fr}
.hiw-row:nth-of-type(even) .hiw-text{order:2}
.hiw-text{max-width:30em}
.hiw-text h3{font-size:24px;letter-spacing:-.015em;margin-bottom:8px}
.hiw-text p{font-size:18px}
.hiw-promise{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
.hiw-promise>div{background:#fff;border:1px solid var(--line);border-radius:16px;padding:22px 22px 10px}
section.final .cta .btn+.btn{margin-left:10px}
@media(max-width:860px){.hiw-steps,.hiw-promise{grid-template-columns:1fr}.hiw-row,.hiw-row:nth-of-type(even){grid-template-columns:1fr;gap:22px}.hiw-row:nth-of-type(even) .hiw-text{order:0}.hiw-row .phone-wrap{order:2}}
</style>
