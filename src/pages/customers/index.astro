---
import Base from "../../layouts/Base.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import StoreButtons from "../../components/StoreButtons.astro";
import "../../styles/site.css";
---
<Base title="Clean Racer \u00b7 Your cleaner, at your door" description="Clean Racer connects you to your local dry cleaner. Book a pickup in seconds, follow every step, and message your cleaner." canonical="https://cleanracer.com/customers/" bodyClass="cust-page" themeColor="#0B0B0D">
<Fragment slot="head">
<style is:global>
@media(min-width:861px){.phones3{grid-template-columns:repeat(5,1fr);gap:36px 16px}
.phones3 .phone{width:184px;border-radius:34px;padding:8px}
.phones3 .screen{border-radius:27px}
.phones3 figcaption{max-width:188px}
.phones3 figcaption b{font-size:16.5px}
.phones3 figcaption span{font-size:14.5px}}
</style>
<style is:global>
:root{--tint:#00A19B;--tint-soft:rgba(0,161,155,.12);--teal-text:#007F7A}
.eyebrow,.tag,h1 em,.band.cust h1 em,.band.cust .eyebrow,.band.cust .btn.plain{color:var(--teal-text)}
.btn.primary{background:var(--teal-text)}
.band.cust .btn.plain{background:rgba(0,161,155,.14)}
.band.cust{background:#fff;color:#111418}
section.final.cust{background:linear-gradient(160deg,#F2FBFA 0%,#D9F3F1 55%,#BDE9E6 100%);color:#111418}
.band.cust::before,.band.cust::after{background:rgba(0,161,155,.08)}
.band.cust h1,section.final.cust h2,.band.cust .note b,.band.cust .btn.soon b{color:#111418}
.band.cust .lede,section.final.cust p,.band.cust .btn.soon{color:#44605E}
.band.cust .note{color:#5F7775}
.band.cust .btn.soon{background:rgba(0,161,155,.12)}
.band::before,.band::after,section.final::before,section.final::after{display:none}
.island{display:none}
.cust-page .phone{background:#fff;border:1px solid #C6C6C8;box-shadow:0 18px 40px -24px rgba(0,0,0,.3)}
</style>
<style is:global>
:root{--bg:#0B0B0D;--grouped:#141416;--card:#1C1C1E;--text:#FFFFFF;--muted:#A8A8AE;--faint:#7C7C82;--line:#2C2C2E;--tint:#2FD6CC;--teal-text:#2FD6CC;--tint-soft:rgba(47,214,204,.14);color-scheme:dark}
html,body{background:#0B0B0D!important;color:#fff}
body{background:linear-gradient(180deg,#2B2B30 0%,#161618 38%,#000 100%) fixed!important}
.band.cust{background:transparent!important;color:#fff}
.band.cust h1,.band.cust .note b,.band.cust .btn.soon b{color:#fff!important}
.band.cust h1 em{color:#2FD6CC!important}
.band.cust .eyebrow,.eyebrow,.tag{color:#2FD6CC!important}
.band.cust .lede,.band.cust .note,.sec-head p{color:#B4B4BA!important}
.band.cust .btn.soon{background:rgba(255,255,255,.08)!important;color:#C9C9CE!important}
.btn.primary{background:#2FD6CC!important;color:#06201F!important}
.band.cust .btn.plain{background:rgba(47,214,204,.14)!important;color:#2FD6CC!important}
section,.gray{background:transparent!important}
section.gray{background:rgba(255,255,255,.03)!important}
h1,h2,h3,.sec-head h2{color:#fff!important}
.step3,.feat{background:#1C1C1E!important;border:1px solid #2C2C2E!important;box-shadow:none!important}
.feat p,.step3 p{color:#A8A8AE!important}
.ico{background:rgba(47,214,204,.14)!important;color:#2FD6CC!important}
.step3::before{background:#2FD6CC!important;color:#06201F!important}
.cust-page .phone{background:#0B0B0D!important;border:1px solid #3A3A3C!important;box-shadow:0 30px 70px -30px rgba(0,0,0,.8),0 0 0 1px rgba(255,255,255,.06)!important}
figcaption b{color:#fff!important}
figcaption span{color:#A8A8AE!important}
section.final.cust{background:linear-gradient(180deg,#161618 0%,#000 100%)!important;color:#fff;border-top:1px solid #2C2C2E}
section.final.cust h2{color:#fff!important}
section.final.cust p{color:#B4B4BA!important}
</style>
<style is:global>
@media(min-width:861px){.phones3{display:flex;flex-wrap:wrap;justify-content:center;gap:36px 16px}.phones3 figure{width:188px}}
.rewards .rw{display:grid;grid-template-columns:1.05fr .95fr;gap:56px;align-items:center}
.rw-steps{list-style:none;counter-reset:rw;display:flex;flex-direction:column;gap:16px;padding:0;margin:26px 0 22px}
.rw-steps li{counter-increment:rw;display:grid;grid-template-columns:34px 1fr;column-gap:14px;row-gap:2px;align-items:start}
.rw-steps li::before{content:counter(rw);grid-row:span 2;width:32px;height:32px;border-radius:50%;background:#2FD6CC;color:#06201F;display:grid;place-items:center;font-weight:800;font-size:15px}
.rw-steps b{font-size:18px;color:#fff}
.rw-steps span{color:#A8A8AE;font-size:16px;line-height:1.45}
.rw-fine{color:#8E8E95;font-size:13.5px;line-height:1.5;max-width:40em;margin:0}
.rw-fine a{color:#2FD6CC}
.rw-visual{display:flex;align-items:center;justify-content:center;gap:22px;flex-wrap:nowrap}
.rw-visual .phone{width:208px;flex:none;border-radius:36px;padding:8px}
.rw-visual .screen{border-radius:29px}
.rw-ring-card{background:#1C1C1E;border:1px solid #2C2C2E;border-radius:26px;padding:24px 18px;display:flex;flex-direction:column;align-items:center;gap:14px;width:204px;flex:none}
@property --rwp{syntax:"<number>";inherits:false;initial-value:60}
.rw-ring{--rwp:60;position:relative;width:140px;height:140px;display:grid;place-items:center;text-align:center;transition:--rwp 1.7s cubic-bezier(.2,.7,.2,1)}
.js .rw-ring:not(.in){--rwp:0}
.rw-ring::before{content:"";position:absolute;inset:0;border-radius:50%;background:conic-gradient(#2FD6CC calc(var(--rwp)*1%),rgba(255,255,255,.13) 0);-webkit-mask:radial-gradient(farthest-side,transparent calc(100% - 13px),#000 calc(100% - 12.5px));mask:radial-gradient(farthest-side,transparent calc(100% - 13px),#000 calc(100% - 12.5px))}
.rw-num{position:relative;display:block;font-size:42px;font-weight:800;line-height:1;letter-spacing:-.02em;color:#fff;font-variant-numeric:tabular-nums}
.rw-unit{position:relative;display:block;margin-top:2px;font-size:15px;color:#A8A8AE}
.rw-cap{text-align:center}
.rw-cap b{display:block;font-size:18px;color:#fff}
.rw-cap span{color:#A8A8AE;font-size:15px}
.rw-eg{font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:#7C7C82}
.feat.wide{grid-column:1/-1;border-color:rgba(47,214,204,.5)!important;background:linear-gradient(135deg,rgba(47,214,204,.14),#1C1C1E 62%)!important}
.feat.wide a{color:#2FD6CC;font-weight:600;white-space:nowrap}
@media(max-width:860px){.rewards .rw{grid-template-columns:1fr;gap:36px}}
@media(max-width:520px){.rw-visual{flex-wrap:wrap}.rw-visual .phone{width:220px}.rw-ring-card{width:220px}}
@media(prefers-reduced-motion:reduce){.rw-ring{transition:none}}
</style>
</Fragment>

<div class="band cust"><div class="wrap">
  <SiteHeader to="cleaners" dark />
<header class="hero">
    <div>
      <span class="eyebrow">Dry cleaning pickup &amp; delivery</span>
      <h1>Dry cleaning. <em>Pit crew included.</em></h1>
      <p class="lede">Pickup and delivery from the dry cleaner you already know and trust. Book a pickup in seconds, follow every step, and message your cleaner.</p>
      <StoreButtons play="https://play.google.com/store/apps/details?id=com.cleanracer.app" app="Clean Racer" />
    </div>
    <div class="phone-wrap"><div class="phone real"><div class="screen"><div class="island"></div><img src="/assets/shots/customer-home.webp" width="620" height="1347" alt="The Clean Racer app's Home screen: an order that is ready for delivery with the amount due, a Request Pickup button, and your other orders in progress."></div></div></div>
  </header>
</div></div>

<section id="how" class="gray"><div class="wrap">
  <div class="sec-head"><span class="tag">How it works</span><h2>Laundry day, handled.</h2><p>Three taps between you and a clean closet.</p></div>
  <div class="steps3">
    <div class="step3"><h3>Link to your cleaner</h3><p>Scan the QR code at your cleaner's counter, or enter their store code. You're set up in under a minute.</p></div>
    <div class="step3"><h3>Pick a time</h3><p>Choose a pickup window that suits you: morning, midday or afternoon. Make it weekly if you like.</p></div>
    <div class="step3"><h3>Hand it off</h3><p>Your driver collects it, your cleaner cleans it, and it comes back to your door. You get an update at every step.</p></div>
  </div>
</div></section>

<section id="rewards" class="rewards"><div class="wrap"><div class="rw">
  <div class="rw-copy">
    <div class="sec-head"><span class="tag">Rewards</span><h2>Every order earns you something back.</h2><p>Where your cleaner offers rewards, you earn points on what you pay, and take $5 off when you pay in the app.</p></div>
    <ol class="rw-steps">
      <li><b>Earn</b><span>1 point for every $1 you pay, once your order is delivered.</span></li>
      <li><b>Collect</b><span>See your points on the Home screen. Each order's points last at least six months.</span></li>
      <li><b>Save</b><span>Use 100 points for $5 off when you pay in the app. One reward per order.</span></li>
    </ol>
    <p class="rw-fine">Rewards are optional and run by your cleaner. Points can't be used when you pay your driver or the store directly, have no cash value, and expire at the end of the month, six months after the month you earned them. See the <a href="/terms/">Terms</a>.</p>
  </div>
  <div class="rw-visual">
    <div class="phone real"><div class="screen"><div class="island"></div><img src="/assets/shots/customer-rewards-home.webp" width="620" height="1347" alt="The Clean Racer Home screen with the rewards card: a ring showing 60 of 100 points, and 40 more points for $5.00 off." loading="lazy"></div></div>
    <div class="rw-ring-card" role="img" aria-label="Example: 60 of 100 points">
      <div class="rw-ring" id="rw-ring"><div><span class="rw-num" id="rw-num">60</span><span class="rw-unit">points</span></div></div>
      <div class="rw-cap"><b>40 more points</b><span>for $5.00 off</span></div>
      <span class="rw-eg">Example</span>
    </div>
  </div>
</div></div></section>

<section id="screens"><div class="wrap">
  <div class="sec-head"><span class="tag">In the app</span><h2>Book it. Follow it. Ask about it.</h2><p>Pick a day and a window, watch your order move, message your cleaner, and earn rewards, all without leaving the app.</p></div>
  <div class="phones3">
    <figure><div class="phone real"><div class="screen"><div class="island"></div><img src="/assets/shots/customer-rewards.webp" width="620" height="1347" alt="Your rewards: your points balance, progress to the next reward, when points expire, and your points history." loading="lazy"></div></div><figcaption><b>Watch your points grow</b><span>Where your cleaner offers rewards.</span></figcaption></figure>
    <figure><div class="phone real"><div class="screen"><div class="island"></div><img src="/assets/shots/customer-reward-pay.webp" width="620" height="1347" alt="Paying for an order with a reward: the amount due, $5.00 off for using 100 points, the convenience fee, and the lower total." loading="lazy"></div></div><figcaption><b>Take $5 off at checkout</b><span>Use 100 points when you pay in the app.</span></figcaption></figure>
    <figure><div class="phone real"><div class="screen"><div class="island"></div><img src="/assets/shots/customer-book.webp" width="620" height="1347" alt="Booking a pickup: choose a day, then a time window."></div></div><figcaption><b>Pick a day and a window</b><span>Morning, midday or afternoon.</span></figcaption></figure>
    <figure><div class="phone real"><div class="screen"><div class="island"></div><img src="/assets/shots/customer-orders.webp" width="620" height="1347" alt="Your orders: active orders with their status and the amount due, and past orders below." loading="lazy"></div></div><figcaption><b>See all your orders</b><span>Active and past, with what is due.</span></figcaption></figure>
    <figure><div class="phone real"><div class="screen"><div class="island"></div><img src="/assets/shots/customer-progress.webp" width="620" height="1347" alt="An order's progress: requested, scheduled, picked up, being cleaned, ready, delivered."></div></div><figcaption><b>Follow every step</b><span>From pickup to your door, with the amount due.</span></figcaption></figure>
    <figure><div class="phone real"><div class="screen"><div class="island"></div><img src="/assets/shots/customer-pay.webp" width="620" height="1347" alt="Paying for an order in the app: the amount due, the cleaner's convenience fee, the total and a Pay button."></div></div><figcaption><b>Pay in the app</b><span>Apple Pay, Google Pay or card, or pay your driver instead.</span></figcaption></figure>
    <figure><div class="phone real"><div class="screen"><div class="island"></div><img src="/assets/shots/customer-messages.webp" width="620" height="1347" alt="A message thread with your cleaner inside the app."></div></div><figcaption><b>Message your cleaner</b><span>Questions about a stain or a button? Just ask.</span></figcaption></figure>
  </div>
</div></section>

<section id="customers"><div class="wrap">
  <div class="sec-head"><span class="tag">For customers · Clean Racer</span><h2>Everything about your order, in one place.</h2><p>No phone tag, no guessing, no mystery bags.</p></div>
  <div class="grid">
    <div class="feat"><div class="ico" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></div><h3>Pickup windows</h3><p>Book a morning, midday or afternoon window. Change it or cancel any time before your cleaner confirms.</p></div>
    <div class="feat"><div class="ico" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M17 3l3 3-3 3"/><path d="M4 11V9a3 3 0 0 1 3-3h13"/><path d="M7 21l-3-3 3-3"/><path d="M20 13v2a3 3 0 0 1-3 3H4"/></svg></div><h3>Weekly pickups</h3><p>Same day, same time, every week. Set it once and forget about it.</p></div>
    <div class="feat"><div class="ico" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 9a6 6 0 0 1 12 0c0 6 2 7 2 7H4s2-1 2-7"/><path d="M10 20a2 2 0 0 0 4 0"/></svg></div><h3>Updates at every step</h3><p>Confirmed, picked up, being cleaned, ready, on the way. A simple push when something changes.</p></div>
    <div class="feat"><div class="ico" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 5h14a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-7l-5 4v-4H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2z"/></svg></div><h3>Message your cleaner</h3><p>Questions about a stain or a button? Ask right inside your order.</p></div>
    <div class="feat"><div class="ico" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 8h3l2-3h6l2 3h3a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1z"/><circle cx="12" cy="13" r="3.5"/></svg></div><h3>Photo at handoff</h3><p>Your driver can snap a photo at pickup and drop-off, so you always know it arrived.</p></div>
    <div class="feat"><div class="ico" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="6" width="18" height="13" rx="2"/><path d="M3 10h18M7 15h4"/></svg></div><h3>Pay your way</h3><p>Pay by card right in the app with Apple Pay, Google Pay or a card, or pay your driver or the counter as you always have. Every payment is recorded.</p></div>
    <div class="feat wide"><div class="ico" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9z"/></svg></div><h3>Earn rewards</h3><p>Where your cleaner offers rewards, every paid order earns points: 1 point for every $1, and 100 points take $5 off when you pay in the app. <a href="#rewards">See how it works</a></p></div>
  </div>
</div></section>

<section class="final cust"><div class="wrap">
  <h2>Clean clothes. Zero hassle.</h2>
  <p>Clean Racer is on Google Play now and coming soon to the App Store. Run a dry cleaner? See how Clean Racer Business works for your team.</p>
  <div class="cta"><a class="btn primary" href="/">For cleaners</a></div>
</div></section>

<script is:inline>
document.documentElement.classList.add("js");
(function(){
  var ring=document.getElementById("rw-ring"), num=document.getElementById("rw-num");
  if(!ring||!num) return;
  var reduce=window.matchMedia&&window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  function go(){
    ring.classList.add("in");
    if(reduce) return;
    var t0=null, to=60, dur=1700;
    num.textContent="0";
    function step(t){ if(t0===null) t0=t; var k=Math.min((t-t0)/dur,1), e=1-Math.pow(1-k,3); num.textContent=String(Math.round(to*e)); if(k<1) requestAnimationFrame(step); }
    requestAnimationFrame(step);
  }
  if(reduce||!("IntersectionObserver" in window)){ ring.classList.add("in"); return; }
  var io=new IntersectionObserver(function(es){ es.forEach(function(e){ if(e.isIntersecting){ go(); io.disconnect(); } }); },{threshold:.5});
  io.observe(ring);
})();
</script>

<SiteFooter dark />
</Base>
